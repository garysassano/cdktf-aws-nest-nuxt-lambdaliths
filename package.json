{
  "name": "cdktn-aws-sveltekit-hono-lambdaliths",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "cdktn": "cdktn",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm synth",
    "deploy": "cdktn deploy --auto-approve",
    "destroy": "cdktn destroy --auto-approve",
    "diff": "cdktn diff",
    "format": "biome format --write .",
    "gen": "cdktn get",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "synth": "cdktn synth",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cdktn": "^0.24.0",
    "constructs": "^10.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/node": "^24.13.3",
    "cdktn-cli": "^0.24.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
